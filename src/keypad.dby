import std.buffer as buf

pub fn new_keypad() -> buffer:
    return buf.new(16)

pub fn is_key_down(keys: buffer, key: int) -> int:
    if key < 0:
        return 0
    if key >= 16:
        return 0
    return buf.get(keys, key)

pub fn set_key(keys: buffer, key: int, pressed: int) -> int:
    if key >= 0:
        if key < 16:
            buf.set(keys, key, pressed)
    return 0

pub fn clear_all(keys: buffer) -> int:
    let i: int = 0
    while i < 16:
        buf.set(keys, i, 0)
        i = i + 1
    return 0
