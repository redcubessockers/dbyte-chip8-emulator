pub fn log2_x1000(val: int) -> int:
    if val <= 1:
        return 0
    if val == 2:
        return 1000
    if val == 3:
        return 1585
    if val == 4:
        return 2000
    if val == 5:
        return 2322
    if val == 6:
        return 2585
    if val == 7:
        return 2807
    if val == 8:
        return 3000
    if val == 16:
        return 4000
    if val == 32:
        return 5000
    if val == 64:
        return 6000
    if val == 128:
        return 7000
    if val >= 256:
        return 8000
    
    let base: int = 1
    let bits: int = 0
    let temp: int = val
    while temp > 1:
        temp = temp / 2
        bits = bits + 1
        base = base * 2
    let rem: int = val - base
    return bits * 1000 + rem * 1000 / base
