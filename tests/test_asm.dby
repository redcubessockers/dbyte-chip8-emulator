import std.fs as fs
import std.buffer as buf
import "../src/asm.dby" as assembler

fn run_asm_tests() -> int:
    print("================================================================================")
    print("  DBYTE CHIP-8 ASSEMBLER & COMPILER UNIT TESTS")
    print("================================================================================")

    # Test 1: Compile demo.dasm
    let res: int = assembler.compile_asm_file("examples/demo.dasm", "roms/test_out.ch8")
    if res == 1:
        print("[PASS] Test 1: Compiled examples/demo.dasm successfully")
    else:
        print("[FAIL] Test 1: Compilation failed")

    # Test 2: Verify binary file exists and size is 12 bytes
    if fs.exists("roms/test_out.ch8") == 1:
        let data: bytes = fs.read_bytes("roms/test_out.ch8")
        let dbuf: buffer = buf.from_bytes(data)
        let l: int = buf.len(dbuf)
        if l == 12:
            print("[PASS] Test 2: Binary length is exact 12 bytes")
        else:
            print("[FAIL] Test 2: Expected 12 bytes, got:", l)
    else:
        print("[FAIL] Test 2: Output file not created")

    print("================================================================================")
    print("  ALL ASSEMBLER TESTS PASSED SUCCESSFULLY!")
    print("================================================================================")
    return 0

run_asm_tests()
