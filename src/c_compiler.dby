import std.buffer as buf
import std.fs as fs
import "./bits.dby" as bits
import "./asm.dby" as asm_mod

# High-Level Script Compiler for CHIP-8
# Compiles structured commands (SET, ADD, DRAW, JUMP, CALL, CLEAR) to CHIP-8 binary

pub fn compile_high_level(in_path: str, out_path: str) -> int:
    if fs.exists(in_path) == 0:
        print("[Error] Source file not found:", in_path)
        return 0

    let raw_bytes: bytes = fs.read_bytes(in_path)
    let in_buf: buffer = buf.from_bytes(raw_bytes)
    let text_len: int = buf.len(in_buf)
    let out_buf: buffer = buf.new(4096)
    let out_pos: int = 0

    print("================================================================================")
    print(" [CHIP-8 HIGH-LEVEL C-SCRIPT COMPILER]")
    print("================================================================================")
    print(" Source File: ", in_path)
    print(" Target ROM:  ", out_path)
    print("--------------------------------------------------------------------------------")

    let line_start: int = 0
    let cur_idx: int = 0
    let line_count: int = 0

    while cur_idx <= text_len:
        let is_eol: int = 0
        if cur_idx == text_len:
            is_eol = 1
        else:
            if buf.get(in_buf, cur_idx) == 10:
                is_eol = 1

        if is_eol == 1:
            let line_end: int = cur_idx
            if line_end > line_start:
                if buf.get(in_buf, line_end - 1) == 13:
                    line_end = line_end - 1

            let line_len: int = line_end - line_start
            if line_len >= 3:
                let ch0: int = buf.get(in_buf, line_start)
                # Skip comments '//' or '#'
                if ch0 != 47:
                    if ch0 != 35:
                        let op: int = 0
                        let is_op: int = 0

                        # CLEAR / CLS
                        if ch0 == 67:
                            op = 0x00E0
                            is_op = 1

                        # SET Vx = val : 'S'(83) 'E'(69) 'T'(84) ' '(32) 'V'(86)
                        if ch0 == 83:
                            if buf.get(in_buf, line_start + 1) == 69:
                                if buf.get(in_buf, line_start + 2) == 84:
                                    let rx: int = asm_mod.parse_nibble_byte(buf.get(in_buf, line_start + 5))
                                    let val: int = asm_mod.parse_hex_slice(in_buf, line_start + 9, line_end)
                                    op = 0x6000 + rx * 256 + (val % 256)
                                    is_op = 1

                        # ADD Vx = val : 'A'(65) 'D'(68) 'D'(68)
                        if ch0 == 65:
                            if buf.get(in_buf, line_start + 1) == 68:
                                if buf.get(in_buf, line_start + 2) == 68:
                                    let rx: int = asm_mod.parse_nibble_byte(buf.get(in_buf, line_start + 5))
                                    let val: int = asm_mod.parse_hex_slice(in_buf, line_start + 9, line_end)
                                    op = 0x7000 + rx * 256 + (val % 256)
                                    is_op = 1

                        # ADDR I = val : 'A'(65) 'D'(68) 'D'(68) 'R'(82)
                        if ch0 == 65:
                            if buf.get(in_buf, line_start + 3) == 82:
                                let val: int = asm_mod.parse_hex_slice(in_buf, line_start + 9, line_end)
                                op = 0xA000 + (val % 4096)
                                is_op = 1

                        # DRAW Vx, Vy, H : 'D'(68) 'R'(82) 'A'(65) 'W'(87)
                        if ch0 == 68:
                            if buf.get(in_buf, line_start + 1) == 82:
                                if buf.get(in_buf, line_start + 2) == 65:
                                    let rx: int = asm_mod.parse_nibble_byte(buf.get(in_buf, line_start + 6))
                                    let ry: int = asm_mod.parse_nibble_byte(buf.get(in_buf, line_start + 10))
                                    let h: int = asm_mod.parse_nibble_byte(buf.get(in_buf, line_start + 14))
                                    op = 0xD000 + rx * 256 + ry * 16 + h
                                    is_op = 1

                        # JUMP addr : 'J'(74) 'U'(85) 'M'(77) 'P'(80)
                        if ch0 == 74:
                            if buf.get(in_buf, line_start + 1) == 85:
                                let addr: int = asm_mod.parse_hex_slice(in_buf, line_start + 5, line_end)
                                op = 0x1000 + (addr % 4096)
                                is_op = 1

                        # CALL addr : 'C'(67) 'A'(65) 'L'(76) 'L'(76)
                        if ch0 == 67:
                            if buf.get(in_buf, line_start + 1) == 65:
                                if line_len >= 8:
                                    let addr: int = asm_mod.parse_hex_slice(in_buf, line_start + 5, line_end)
                                    op = 0x2000 + (addr % 4096)
                                    is_op = 1

                        if is_op == 1:
                            let hi_byte: int = (op / 256) % 256
                            let lo_byte: int = op % 256
                            buf.set(out_buf, out_pos, hi_byte)
                            buf.set(out_buf, out_pos + 1, lo_byte)
                            print(" 0x" + bits.hex_u16(0x0200 + out_pos) + " | 0x" + bits.hex_u16(op))
                            out_pos = out_pos + 2
                            line_count = line_count + 1

            line_start = cur_idx + 1
        cur_idx = cur_idx + 1

    let out_slice: buffer = buf.new(out_pos)
    let bi: int = 0
    while bi < out_pos:
        buf.set(out_slice, bi, buf.get(out_buf, bi))
        bi = bi + 1

    let out_bytes: bytes = buf.to_bytes(out_slice)
    fs.write_bytes(out_path, out_bytes)

    print("--------------------------------------------------------------------------------")
    print("[+] Successfully compiled " + bits.hex_u16(line_count) + " high-level statements into " + bits.hex_u16(out_pos) + " bytes.")
    print("[+] Output ROM saved to: " + out_path)
    print("================================================================================")
    return 1
