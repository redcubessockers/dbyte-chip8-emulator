import std.buffer as buf

pub fn clear(gfx: buffer) -> int:
    let i: int = 0
    while i < 2048:
        buf.set(gfx, i, 0)
        i = i + 1
    return 0

pub fn get_pixel(gfx: buffer, x: int, y: int) -> int:
    let wrap_x: int = x % 64
    let wrap_y: int = y % 32
    return buf.get(gfx, wrap_y * 64 + wrap_x)

pub fn set_pixel(gfx: buffer, x: int, y: int, val: int) -> int:
    let wrap_x: int = x % 64
    let wrap_y: int = y % 32
    buf.set(gfx, wrap_y * 64 + wrap_x, val)
    return 0

pub fn render_framebuffer_clean(gfx: buffer) -> int:
    print("+----------------------------------------------------------------+")
    let y: int = 0
    while y < 32:
        let line: str = "|"
        let x: int = 0
        while x < 64:
            let pixel: int = buf.get(gfx, y * 64 + x)
            if pixel == 1:
                line = line + "#"
            else:
                line = line + " "
            x = x + 1
        line = line + "|"
        print(line)
        y = y + 1
    print("+----------------------------------------------------------------+")
    return 0
