import std.buffer as buf
import std.fs as fs

pub fn get_ibm_logo_bytes() -> bytes:
    return b"\x00\xE0\xA2\x2A\x60\x0C\x61\x08\xD0\x1F\x70\x08\xA2\x39\xD0\x1F\xA2\x48\x70\x08\xD0\x1F\x70\x04\xA2\x57\xD0\x1F\x70\x08\xA2\x66\xD0\x1F\x70\x08\xA2\x75\xD0\x1F\x12\x28\x00\x00\xFF\x00\xFF\x00\x3C\x00\x3C\x00\x3C\x00\x3C\x00\xFF\x00\xFF\xFF\x00\xFF\x00\x38\x00\x3F\x00\x3F\x00\x38\x00\xFF\x00\xFF\x00\xFF\x00\xFF\x00\x1C\x00\x1C\x00\x1C\x00\x1C\x00\x1C\x00\x1C\x00\xFC\x00\xFC\x00\x00\x00\x00\x00\x00\x00\x00\x00\xFF\x00\xFF\x00\xE0\x00\xE0\x00\xE0\x00\xE0\x00\xFF\x00\xFF\x00\x03\x00\x03\x00\x03\x00\x03\x00\xFF\x00\xFF"

pub fn get_maze_bytes() -> bytes:
    return b"\x00\xE0\xA2\x12\xC0\x01\x30\x00\x12\x0C\xD1\x21\x71\x04\x31\x40\x12\x04\x61\x00\x72\x04\x32\x20\x12\x04\x12\x00\x80\x40\x20\x10"

pub fn get_pong_bytes() -> bytes:
    return b"\x6A\x02\x6B\x0C\x6C\x3F\x6D\x0C\xA2\xEA\xDA\xB6\xDC\xD6\x6E\x00\x22\xD4\x66\x03\x68\x02\x60\x60\xF0\x15\xF0\x07\x30\x00\x12\x1A\xC7\x17\x77\x08\x69\xFF\xA2\xF0\xD6\x71\xA2\xEA\xDA\xB6\xDC\xD6\x60\x01\xE0\xA1\x7B\xFE\x60\x04\xE0\xA1\x7B\x02\x60\x1F\x8B\x02\xDA\xB6\x60\x0C\xE0\xA1\x7D\xFE\x60\x0D\xE0\xA1\x7D\x02\x60\x1F\x8D\x02\xDC\xD6\xA2\xF0\xD6\x71\x86\x84\x87\x94\x60\x3F\x86\x02\x61\x1F\x87\x12\xD6\x71\x12\x2A"

pub fn get_brix_bytes() -> bytes:
    return b"\x12\x1E\xC0\x07\x30\x00\x12\x02\x61\x02\x62\x0A\xA2\x20\xD1\x21\x71\x04\x31\x3E\x12\x0E\x61\x02\x72\x02\x32\x10\x12\x0E\x12\x1C\xFF\x00"

pub fn get_starfield_bytes() -> bytes:
    return b"\x00\xE0\x60\x00\x61\x00\xC2\x3F\xC3\x1F\xA2\x16\xD2\x31\x70\x01\x30\x50\x12\x06\x12\x14\x80\x00"

pub fn export_bundled_roms(target_dir: str) -> int:
    fs.write_bytes(target_dir + "/ibm_logo.ch8", get_ibm_logo_bytes())
    fs.write_bytes(target_dir + "/maze.ch8", get_maze_bytes())
    fs.write_bytes(target_dir + "/pong.ch8", get_pong_bytes())
    fs.write_bytes(target_dir + "/brix.ch8", get_brix_bytes())
    fs.write_bytes(target_dir + "/starfield.ch8", get_starfield_bytes())
    return 0
