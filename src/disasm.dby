import "./bits.dby" as bits

pub fn disassemble_op(op: int) -> str:
    let n3: int = (op / 4096) % 16
    let n2: int = (op / 256) % 16
    let n1: int = (op / 16) % 16
    let n0: int = op % 16
    let nnn: int = op % 4096
    let kk: int = op % 256

    let rx: str = "V" + bits.hex_nibble(n2)
    let ry: str = "V" + bits.hex_nibble(n1)
    let nnn_str: str = "0x" + bits.hex_u16(nnn)
    let kk_str: str = "0x" + bits.hex_u8(kk)
    let n0_str: str = bits.hex_nibble(n0)

    if n3 == 0x0:
        if op == 0x00E0:
            return "CLS"
        if op == 0x00EE:
            return "RET"
        return "SYS " + nnn_str

    if n3 == 0x1:
        return "JP " + nnn_str
    if n3 == 0x2:
        return "CALL " + nnn_str + "  ; [sub_" + bits.hex_u16(nnn) + "]"
    if n3 == 0x3:
        return "SE " + rx + ", " + kk_str
    if n3 == 0x4:
        return "SNE " + rx + ", " + kk_str
    if n3 == 0x5:
        return "SE " + rx + ", " + ry
    if n3 == 0x6:
        return "LD " + rx + ", " + kk_str
    if n3 == 0x7:
        return "ADD " + rx + ", " + kk_str

    if n3 == 0x8:
        if n0 == 0x0:
            return "LD " + rx + ", " + ry
        if n0 == 0x1:
            return "OR " + rx + ", " + ry
        if n0 == 0x2:
            return "AND " + rx + ", " + ry
        if n0 == 0x3:
            return "XOR " + rx + ", " + ry
        if n0 == 0x4:
            return "ADD " + rx + ", " + ry + "  ; Carry"
        if n0 == 0x5:
            return "SUB " + rx + ", " + ry + "  ; NotBorrow"
        if n0 == 0x6:
            return "SHR " + rx + ", " + ry
        if n0 == 0x7:
            return "SUBN " + rx + ", " + ry
        if n0 == 0xE:
            return "SHL " + rx + ", " + ry
        return "UNKNOWN_ALU " + bits.hex_u16(op)

    if n3 == 0x9:
        return "SNE " + rx + ", " + ry
    if n3 == 0xA:
        return "LD I, " + nnn_str
    if n3 == 0xB:
        return "JP V0, " + nnn_str
    if n3 == 0xC:
        return "RND " + rx + ", " + kk_str
    if n3 == 0xD:
        return "DRW " + rx + ", " + ry + ", " + n0_str

    if n3 == 0xE:
        if kk == 0x9E:
            return "SKP " + rx
        if kk == 0xA1:
            return "SKNP " + rx
        return "UNKNOWN_KEY " + bits.hex_u16(op)

    if n3 == 0xF:
        if kk == 0x07:
            return "LD " + rx + ", DT"
        if kk == 0x0A:
            return "LD " + rx + ", K"
        if kk == 0x15:
            return "LD DT, " + rx
        if kk == 0x18:
            return "LD ST, " + rx
        if kk == 0x1E:
            return "ADD I, " + rx
        if kk == 0x29:
            return "LD F, " + rx
        if kk == 0x33:
            return "LD B, " + rx + "  ; BCD"
        if kk == 0x55:
            return "LD [I], " + rx + "  ; Reg Dump"
        if kk == 0x65:
            return "LD " + rx + ", [I]  ; Reg Restore"
        return "UNKNOWN_MISC " + bits.hex_u16(op)

    return "DATA 0x" + bits.hex_u16(op)
